                                "1 a 2 tortillas de maíz nixtamalizado.",
                                "Té de manzanilla."
                            ],
                            tip: "Proteína restringida pero de altísimo valor biológico sin aporte de fósforo inorgánico."
                        },
                        colacion: {
                            titulo: "Manzana Cocida con Canela y Galletas Marías",
                            ingredientes: [
                                "1 manzana pequeña pelada y cocida al vapor con canela en polvo.",
                                "4 piezas de galletas tipo María.",
                                "Agua simple."
                            ],
                            tip: "Aporte energético no proteico seguro para la función renal."
                        },
                        comida: {
                            titulo: "Pechuga de Pollo al Pastor Casero con Piña",
                            ingredientes: [
                                "90g de pechuga de pollo marinada en achiote casero, vinagre y chile guajillo (sin sal agregada).",
                                "Asada con 2 rebanadas de piña fresca y cebolla al comal.",
                                "2 tortillas de maíz.",
                                "1/2 taza de arroz blanco cocido con verduras permitidas."
                            ],
                            tip: "Limitar o remojar previamente ingredientes ricos en potasio segun prescripción del nefrólogo."
                        },
                        cena: {
                            titulo: "Quesadilla de Maíz con Queso Panela Bajo en Sodio y Calabacitas",
                            ingredientes: [
                                "1 a 2 tortillas de maíz nixtamalizado con 30g de queso panela bajo en sodio.",
                                "1 taza de calabacitas a la mexicana al vapor.",
                                "Té helado de limón casero."
                            ],
                            tip: "Evitar sazonadores artificiales, consomé de pollo en polvo o sal de mesa."
                        }
                    };

                case 'erc_dialisis':
                    return {
                        desayuno: {
                            titulo: "Huevos Enteros con Machaca Deshebrada Magra y Tortilla",
                            ingredientes: [
                                "2 huevos enteros revueltos con 30g de carne seca tipo machaca magra (sin sal añadida).",
                                "2 tortillas de maíz nixtamalizado.",
                                "1/3 de aguacate."
                            ],
                            tip: "Proteína concentrada necesaria para compensar pérdidas en el dializado. Estricto control de líquidos."
                        },
                        colacion: {
                            titulo: "Tostada de Tinga de Pollo y Gelatina de Agua",
                            ingredientes: [
                                "1 tostada horneada con 50g de tinga de pechuga de pollo.",
                                "1/2 taza de gelatina de agua de sabor."
                            ],
                            tip: "Contabilizar el volumen hídrico de la gelatina en el registro diario."
                        },
                        comida: {
                            titulo: "Bistec de Res Magro a la Mexicana con Arroz Blanco",
                            ingredientes: [
                                "120g a 150g de bistec de res magro (cecina limpia o bola) asado a la mexicana.",
                                "1/2 taza de arroz blanco seco.",
                                "2 tortillas de maíz."
                            ],
                            tip: "Acompañar con quelantes de fósforo según indicación médica estricta."
                        },
                        cena: {
                            titulo: "Ensalada de Pollo Deshebrado con Cítricos",
                            ingredientes: [
                                "100g de pechuga de pollo deshebrada sobre cama de lechuga, gajos de toronja o mandarina y aceite de oliva."
                            ],
                            tip: "Cena proteica de volumen controlado e hiperproteica."
                        }
                    };

                case 'deporte_resistencia':
                case 'deporte_fuerza':
                    return {
                        desayuno: {
                            titulo: "Molletes Mexicanos Proteicos con Huevos y Frijoles Refritos al Comal",
                            ingredientes: [
                                "1 pieza de bolillo integral sin migajón untado con 1/2 taza de frijoles negros refritos en sartén antiadherente.",
                                "60g de queso panela o manchego bajo en grasa fundido.",
                                "2 huevos estrellados al comal encima con salsa verde o roja casera.",
                                "1 plátano dominico o manzana.",
                                "Licuado de avena con leche descremada o almendras."
                            ],
                            tip: "Excelente densidad de carbohidratos complejos y aminoácidos para síntesis muscular."
                        },
                        colacion: {
                            titulo: "Licuado Energético de Plátano con Amaranto, Chía y Miel",
                            ingredientes: [
                                "250ml de leche o bebida vegetal.",
                                "1 plátano maduro.",
                                "3 cucharadas de amaranto natural mexicano.",
                                "1 cucharada de semillas de chía."
                            ],
                            tip: "Ideal pre u post entrenamiento con alta biodisponibilidad."
                        },
                        comida: {
                            titulo: "Pechuga de Pollo asada con Frijoles Charros Ligeros y Arroz Rojo",
                            ingredientes: [
