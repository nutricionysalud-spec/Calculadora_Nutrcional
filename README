    <script>
        // Global variables
        let macroChartInst = null;
        let currentCalculatedData = {};

        // DOM references
        const form = document.getElementById('reqForm');
        const inputs = form.querySelectorAll('input, select');
        const radioTiempos = document.querySelectorAll('input[name="tiemposComida"]');

        document.addEventListener('DOMContentLoaded', () => {
            initChart();
            calcularRequerimientos();
            // Escuchar cambios en radio buttons de tiempos
            radioTiempos.forEach(r => r.addEventListener('change', generarMenuMexicano));
        });

        inputs.forEach(input => {
            input.addEventListener('input', () => {
                calcularRequerimientos();
                generarMenuMexicano();
            });
        });

        function initChart() {
            const ctx = document.getElementById('macroChart').getContext('2d');
            macroChartInst = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Proteínas', 'Carbohidratos', 'Grasas'],
                    datasets: [{
                        data: [30, 40, 30],
                        backgroundColor: ['#2563eb', '#10b981', '#f59e0b'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: ${context.raw}%`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function calcularRequerimientos() {
            const peso = parseFloat(document.getElementById('peso').value) || 0;
            const talla = parseFloat(document.getElementById('talla').value) || 0;
            const edad = parseInt(document.getElementById('edad').value) || 0;
            const sexo = document.getElementById('sexo').value;
            const actividad = parseFloat(document.getElementById('actividad').value);
            const condicion = document.getElementById('condicion').value;

            if (!peso || !talla || !edad) return;

            // IMC
            const tallaM = talla / 100;
            const imc = peso / (tallaM * tallaM);

            // Mifflin-St Jeor
            let geb = (10 * peso) + (6.25 * talla) - (5 * edad);
            geb += (sexo === 'M') ? 5 : -161;

            let get = geb * actividad;

            let protG_kg = 1.0;
            let fatPct = 30;
            let addedKcal = 0;

            let criticoText = "";
            let microsArr = [];
            let notasExtra = "";

            switch(condicion) {
                case 'sano':
                    protG_kg = (actividad > 1.5) ? 1.3 : 1.0;
                    fatPct = 30;
                    criticoText = "Paciente asintomático. Monitorear ingesta diaria de fibra (25-35g/día), hidratación óptima (30-35 ml/kg) y limitar azúcares añadidos a <10% de la energía total.";
                    microsArr = [
                        "<b>Calcio:</b> 1,000 mg/día",
                        "<b>Hierro:</b> 8 mg (H) / 18 mg (M) al día",
                        "<b>Vitamina D:</b> 600-800 UI/día",
                        "<b>Sodio:</b> < 2,300 mg/día (máx 5g sal)"
                    ];
                    notasExtra = "Patrón dietético de mantenimiento para prevención primaria de enfermedades cardiometabólicas.";
                    break;

                case 'embarazo':
                    addedKcal = 350; // Promedio 2do/3er trimestre
                    protG_kg = 1.2;
                    fatPct = 30;
                    criticoText = "ALERTA CRÍTICA: Suplementación obligatoria de Ácido Fólico (600 mcg/día) para prevención de defectos del tubo neural. Monitoreo estricto de Hierro sérico, Calcio y tamizaje de Diabetes Gestacional.";
                    microsArr = [
                        "<b>Ácido Fólico:</b> 600 mcg/día",
                        "<b>Hierro Elemental:</b> 27 mg/día",
                        "<b>Calcio:</b> 1,000 - 1,200 mg/día",
                        "<b>DHA (Omega-3):</b> 200-300 mg/día (Desarrollo cerebral fetal)",
                        "<b>Yodo:</b> 220 mcg/día"
                    ];
                    notasExtra = "Se adicionan +350 kcal/día correspondientes al requerimiento gestacional avanzado.";
                    break;

                case 'lactancia':
                    addedKcal = 500;
                    protG_kg = 1.4;
                    fatPct = 30;
                    criticoText = "ALERTA CRÍTICA: Elevada demanda hídrica y calórica para síntesis de leche. Requerimiento hídrico adicional de +800 a 1000 ml/día. Riesgo de depleción de calcio óseo materno.";
                    microsArr = [
                        "<b>Vitamina A:</b> 1,300 mcg/día",
                        "<b>Calcio:</b> 1,000 mg/día",
                        "<b>Yodo:</b> 290 mcg/día",
                        "<b>Agua Total:</b> 3.1 - 3.8 Litros/día"
                    ];
                    notasExtra = "Incluye un superávit de 500 kcal exclusivo para la producción láctea.";
                    break;

                case 'deporte_resistencia':
                    protG_kg = 1.5;
                    fatPct = 25; // Prioriza Carbohidratos para reservas de glucógeno
                    criticoText = "ALERTA CRÍTICA: Tasa de reposición de Glucógeno muscular e hídrico. Monitorear pérdidas de Sodio/Potasio por sudoración en sesiones >60 min. Riesgo de Triada de la Atleta / RED-S.";
                    microsArr = [
                        "<b>Carbohidratos:</b> 6 - 10 g/kg/día según volumen",
                        "<b>Electrolitos (Sodio):</b> 500-700 mg por litro de sudor",
                        "<b>Hierro:</b> Vigilar ferritina (riesgo de hemólisis por impacto)",
                        "<b>Antioxidantes:</b> Vitamina C, E y Polifenoles"
                    ];
                    notasExtra = "Enfoque en alta disponibilidad de glucógeno mediante fuentes complejas y de rápida absorción intra/post entreno.";
                    break;

                case 'deporte_fuerza':
                    protG_kg = 1.9; // 1.6 - 2.2 g/kg
                    fatPct = 25;
                    criticoText = "ALERTA CRÍTICA: Distribuir dosis proteicas cada 3-4 horas (20-40g con ~3g de Leucina por comida). Garantizar superávit calórico leve (200-400 kcal) si el objetivo es hipertrofia.";
                    microsArr = [
                        "<b>Proteína:</b> 1.8 - 2.2 g/kg (Alto valor biológico)",
                        "<b>Creatina Monohidratada:</b> 3 - 5 g/día",
                        "<b>Magnesio:</b> 350-400 mg/día (Función neuromuscular)",
                        "<b>Vitamina D:</b> Optimizar niveles séricos (>30 ng/mL)"
                    ];
                    notasExtra = "Priorizar proteínas de alta calidad e ingesta suficiente de carbohidratos para sostener la intensidad del entrenamiento.";
                    break;

                case 'diabetes':
                    protG_kg = 1.1;
                    fatPct = 35; // Grasas monoinsaturadas para mitigar picos glucémicos
                    criticoText = "ALERTA CRÍTICA: Control estricto del Índice y Carga Glucémica. Prohibición de azúcares simples libres. Vigilar riesgo de hipoglucemias si usa sulfonilureas o insulina. Monitorear Hemoglobina Glicosilada (HbA1c).";
                    microsArr = [
                        "<b>Fibra Soluble/Insoluble:</b> > 35 g/día (ralentiza absorción)",
                        "<b>Magnesio y Cromo:</b> Co-factores de sensibilidad a la insulina",
                        "<b>Ácidos Grasos MUFA:</b> Aceite de oliva, aguacate, semillas",
                        "<b>Sodio:</b> < 2,000 mg/día (Protección cardiovascular)"
                    ];
                    notasExtra = "Carbohidratos de absorción lenta (leguminosas, verduras con cáscara, grano entero) combinados siempre con fibra y proteína.";
                    break;
                
                case 'erc_predialisis':
                    protG_kg = 0.7; // Restricción proteica para reducir hiperfiltración glomerular
                    fatPct = 35;
                    criticoText = "ALERTA CRÍTICA GRAVE: RESTRICCIÓN PROTEICA ESTRICTA (0.6 - 0.8 g/kg) para retrasar progresión a diálisis. Monitoreo semanal de Fósforo, Potasio, Urea y Creatinina sérica. Control de nitrógeno ureico.";
                    microsArr = [
                        "<b>Fósforo:</b> Restringir a 800 - 1,000 mg/día",
                        "<b>Potasio:</b> Ajustar individualmente según kaliemia (<2,000 mg/día si hay hiperkalemia)",
                        "<b>Sodio:</b> < 1,500 - 2,000 mg/día",
                        "<b>Calcio:</b> Monitoreo regulado por nivel de PTH"
                    ];
                    notasExtra = "Sostener 30-35 kcal/kg no proteicas (a base de grasas saludables y carbohidratos complejos) para evitar catabolismo muscular.";
                    break;

                case 'erc_dialisis':
                    protG_kg = 1.3; // Aumento proteico por pérdidas en líquido dializado
                    fatPct = 30;
                    criticoText = "ALERTA CRÍTICA GRAVE: PÉRDIDA PROTEICA DIARIA EN DIÁLISIS. Ingesta elevada (>1.2 g/kg). Restricción Severa de Líquidos Interdiálisis y Control Estricto de Potasio y Fósforo para evitar arritmias o paro cardíaco.";
                    microsArr = [
                        "<b>Fósforo:</b> Restricción estricta y uso de quelantes con alimentos",
                        "<b>Potasio:</b> Altamente restringido según analítica",
                        "<b>Vitaminas Hidrosolubles:</b> Suplementación posdiálisis (Complejo B, C)",
                        "<b>Líquidos Totales:</b> 500 ml + volumen de diuresis residual"
                    ];
                    notasExtra = "Se demanda proteína de alto valor biológico (huevo, carnes magras) ajustando el volumen hídrico total.";
                    break;

                case 'hta':
                    if (imc > 25) addedKcal = -350;
                    protG_kg = 1.0;
                    fatPct = 30;
                    criticoText = "ALERTA CRÍTICA: Estructura de Dieta DASH. Restricción drástica de Sodio (<1,500 - 2,000 mg/día). Aumentar el aporte de Potasio, Magnesio y Calcio dietético para favorecer la vasodilatación.";
                    microsArr = [
                        "<b>Sodio:</b> < 1,500 mg/día (Eliminar sal de mesa y ultraprocesados)",
                        "<b>Potasio:</b> 3,500 - 4,700 mg/día (Vegetales de hoja verde, aguacate)",
                        "<b>Magnesio:</b> 400 mg/día",
                        "<b>Fibra Alimentaria:</b> > 30 g/día"
                    ];
                    notasExtra = "Énfasis en ingredientes frescos, especias naturales (epazote, ajo, cilantro) sin sal añadida.";
                    break;

                case 'obesidad':
                    addedKcal = -500; // Déficit calórico sostenible
                    protG_kg = 1.5; // Proteína elevada para preservar masa libre de grasa y saciedad
                    fatPct = 28;
                    criticoText = "ALERTA CRÍTICA: Preservar Masa Muscular durante el déficit calórico. Monitorear perfil lipídico (Triglicéridos, C-HDL, C-LDL) y glucemia en ayunas. Control de hormonas de saciedad mediante alto volumen vegetal.";
                    microsArr = [
                        "<b>Fibra Total:</b> 35 - 40 g/día (Volumen y saciedad prolongada)",
                        "<b>Vitamina D y Calcio:</b> Deficiencias frecuentes en obesidad",
                        "<b>Agua:</b> 2.5 - 3.0 Litros diarios previos a comidas"
                    ];
                    notasExtra = "Se aplicó un déficit planificado de ~500 kcal/día. La proteína alta mitiga la sarcopenia por reducción calórica.";
                    break;

                case 'critico':
                    get = get * 1.35; // Factor de estrés (sepsis, trauma, quemaduras)
                    protG_kg = 1.8;
                    fatPct = 25;
                    criticoText = "ALERTA EXTREMADAMENTE CRÍTICA: Estado Hipercatabólico e Hipermetabólico. Riesgo alto de SÍNDROME DE REALIMENTACIÓN. Monitoreo continuo de Fosfato, Magnesio y Potasio sérico. Control estricto de Glucemia (target 140-180 mg/dL).";
                    microsArr = [
                        "<b>Glutamina:</b> Considerar 0.3 - 0.5 g/kg/día en traumas/quemados",
                        "<b>Zinc, Selenio, Vitamina C y E:</b> Altas dosis antioxidantes",
                        "<b>Electrolitos:</b> Monitorear Fosfato, Potasio y Magnesio cada 12-24h"
                    ];
                    notasExtra = "Soporte metabólico ajustado por estrés severo. Preferir nutrición enteral temprana con fórmulas hiperproteicas.";
                    break;
            }

            /* Final Calculations */
            let finalKcal = get + addedKcal;
            if (finalKcal < 1200) finalKcal = 1200; // Floor de seguridad clínica

            let protGramos = peso * protG_kg;
            let protKcal = protGramos * 4;

            let fatKcal = finalKcal * (fatPct / 100);
            let fatGramos = fatKcal / 9;

            let choKcal = finalKcal - protKcal - fatKcal;
            let choGramos = choKcal / 4;

            if (choKcal < 0) {
                choKcal = finalKcal * 0.15;
                choGramos = choKcal / 4;
                protKcal = finalKcal - fatKcal - choKcal;
                protGramos = protKcal / 4;
                protG_kg = protGramos / peso;
            }

            let pPct = (protKcal / finalKcal) * 100;
            let cPct = (choKcal / finalKcal) * 100;
            let fPct = (fatKcal / finalKcal) * 100;

            // Save to global object for menu generator
            currentCalculatedData = {
                kcal: Math.round(finalKcal),
                protG: Math.round(protGramos),
                choG: Math.round(choGramos),
                fatG: Math.round(fatGramos),
                condicion: condicion,
                peso: peso
            };

            // Update UI
            document.getElementById('resKcal').textContent = currentCalculatedData.kcal.toLocaleString();
            document.getElementById('resIMCInfo').textContent = `IMC: ${imc.toFixed(1)} kg/m² (${clasificarIMC(imc)})`;

            document.getElementById('resProtG').textContent = currentCalculatedData.protG;
            document.getElementById('resProtPct').textContent = pPct.toFixed(1);
            document.getElementById('resProtKcal').textContent = Math.round(protKcal);
            document.getElementById('infoProtRatio').textContent = `${protG_kg.toFixed(2)} g/kg`;

            document.getElementById('resChoG').textContent = currentCalculatedData.choG;
            document.getElementById('resChoPct').textContent = cPct.toFixed(1);
            document.getElementById('resChoKcal').textContent = Math.round(choKcal);

            document.getElementById('resFatG').textContent = currentCalculatedData.fatG;
            document.getElementById('resFatPct').textContent = fPct.toFixed(1);
            document.getElementById('resFatKcal').textContent = Math.round(fatKcal);
            document.getElementById('infoFatRatio').textContent = `${fatPct.toFixed(1)}% total`;

            document.getElementById('resCritico').innerHTML = criticoText;
            document.getElementById('resNotasExtra').textContent = notasExtra;

            // Render Micros list
            const microsContainer = document.getElementById('resMicros');
            microsContainer.innerHTML = '';
            microsArr.forEach(m => {
                const item = document.createElement('div');
                item.className = "flex items-start gap-2 bg-slate-50 p-2.5 rounded-lg border border-slate-200/60";
                item.innerHTML = `<svg class="w-4 h-4 text-emerald-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                  <span>${m}</span>`;
                microsContainer.appendChild(item);
            });

            // Update Doughnut Chart
            macroChartInst.data.datasets[0].data = [
                parseFloat(pPct.toFixed(1)),
                parseFloat(cPct.toFixed(1)),
                parseFloat(fPct.toFixed(1))
            ];
            macroChartInst.update();
        }

        function clasificarIMC(imc) {
            if (imc < 18.5) return "Bajo Peso";
            if (imc < 25) return "Peso Normal";
            if (imc < 30) return "Sobrepeso";
            if (imc < 35) return "Obesidad I";
            if (imc < 40) return "Obesidad II";
            return "Obesidad III";
        }

        function generarMenuMexicano() {
            if (!currentCalculatedData.kcal) return;

            const numTiempos = parseInt(document.querySelector('input[name="tiemposComida"]:checked').value);
            const { kcal, protG, choG, fatG, condicion } = currentCalculatedData;

            // Percentage distribution per meal count
            let distribucion = [];
            if (numTiempos === 3) {
                distribucion = [
                    { nombre: 'Desayuno', pct: 0.30, icono: '🍳' },
                    { nombre: 'Comida', pct: 0.40, icono: '🍲' },
                    { nombre: 'Cena', pct: 0.30, icono: '🌮' }
                ];
            } else if (numTiempos === 4) {
                distribucion = [
                    { nombre: 'Desayuno', pct: 0.25, icono: '🍳' },
                    { nombre: 'Colación Matutina', pct: 0.15, icono: '🍎' },
                    { nombre: 'Comida', pct: 0.35, icono: '🍲' },
                    { nombre: 'Cena', pct: 0.25, icono: '🌮' }
                ];
            } else if (numTiempos === 5) {
                distribucion = [
                    { nombre: 'Desayuno', pct: 0.25, icono: '🍳' },
                    { nombre: 'Colación Matutina', pct: 0.10, icono: '🍏' },
                    { nombre: 'Comida', pct: 0.35, icono: '🍲' },
                    { nombre: 'Colación Vespertina', pct: 0.10, icono: '🥑' },
                    { nombre: 'Cena', pct: 0.20, icono: '🌮' }
                ];
            } else if (numTiempos === 6) {
                distribucion = [
                    { nombre: 'Desayuno', pct: 0.20, icono: '🍳' },
                    { nombre: 'Colación 1', pct: 0.10, icono: '🍏' },
                    { nombre: 'Comida', pct: 0.30, icono: '🍲' },
                    { nombre: 'Colación 2', pct: 0.10, icono: '🥑' },
                    { nombre: 'Cena', pct: 0.20, icono: '🌮' },
                    { nombre: 'Colación Nocturna', pct: 0.10, icono: '🥛' }
                ];
            }

            // Database of Mexican dishes tailored per condition
            const platillosDB = obtenerPlatillosMexicanos(condicion);

            const container = document.getElementById('menuContainer');
            container.innerHTML = '';

            distribucion.forEach((tiempo, idx) => {
                const tKcal = Math.round(kcal * tiempo.pct);
                const tProt = Math.round(protG * tiempo.pct);
                const tCho = Math.round(choG * tiempo.pct);
                const tFat = Math.round(fatG * tiempo.pct);

                // Select meal template based on meal type
                let mealType = 'desayuno';
                if (tiempo.nombre.toLowerCase().includes('comida')) mealType = 'comida';
                else if (tiempo.nombre.toLowerCase().includes('cena')) mealType = 'cena';
                else if (tiempo.nombre.toLowerCase().includes('colación')) mealType = 'colacion';

                const opcionPlatillo = platillosDB[mealType] || platillosDB['desayuno'];

                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3 transition-all hover:border-emerald-300";
                card.innerHTML = `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2">
                            <span class="text-2xl">${tiempo.icono}</span>
                            <div>
                                <h4 class="font-extrabold text-slate-900 text-base">${tiempo.nombre}</h4>
                                <span class="text-xs text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">
                                    Aprox. ${tKcal} kcal (${Math.round(tiempo.pct * 100)}% del día)
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-xs font-medium text-slate-600 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200/80">
                            <span><b>P:</b> ${tProt}g</span>
                            <span><b>C:</b> ${tCho}g</span>
                            <span><b>G:</b> ${tFat}g</span>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h5 class="font-bold text-slate-800 text-sm flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                            ${opcionPlatillo.titulo}
                        </h5>
                        <ul class="text-xs text-slate-700 space-y-1.5 pl-4 list-disc marker:text-emerald-500">
                            ${opcionPlatillo.ingredientes.map(ing => `<li>${ing}</li>`).join('')}
                        </ul>
                    </div>

                    ${opcionPlatillo.tip ? `
                        <div class="mt-2 p-2.5 bg-amber-50/80 rounded-xl border border-amber-200/60 text-[11px] text-amber-900 flex items-start gap-2">
                            <svg class="w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <span><b>Consejo de Preparación Clínica:</b> ${opcionPlatillo.tip}</span>
                        </div>
                    ` : ''}
                `;
                container.appendChild(card);
            });

            document.getElementById('menuActions').classList.remove('hidden');
        }

        function obtenerPlatillosMexicanos(condicion) {
            // Default Mexican dishes adjusted per condition
            switch(condicion) {
                case 'diabetes':
                    return {
                        desayuno: {
                            titulo: "Huevos Revueltos con Nopales a la Mexicana y Frijoles de la Olla",
                            ingredientes: [
                                "2 piezas de huevo fresco (o 1 huevo + 2 claras) revueltos con 1 taza de nopales picados, jitomate, cebolla y chile verde al comal.",
                                "1/2 taza de frijoles negros o bayos de la olla (enteros, no refritos) sazonados con epazote.",
                                "2 tortillas de maíz nixtamalizado tradicionales.",
                                "1/3 de pieza de aguacate hass.",
                                "Té verde o café americano sin azúcar."
                            ],
                            tip: "Los nopales y el epazote aportan fibra soluble que reduce el impacto glucémico de la comida."
