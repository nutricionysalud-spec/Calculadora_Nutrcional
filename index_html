            // Percentage distribution per meal count
            let distribucion = [];
            if (numTiempos === 3) {
                distribucion = [
                    { nombre: 'Desayuno', pct: 0.30, icono: '🍳' },
                    { nombre: 'Comida', pct: 0.40, icono: '🍲' },
