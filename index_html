                distribucion = [
                    { nombre: 'Desayuno', pct: 0.25, icono: '🍳' },
                    { nombre: 'Colación Matutina', pct: 0.15, icono: '🍎' },
                    { nombre: 'Comida', pct: 0.35, icono: '🍲' },
                    { nombre: 'Cena', pct: 0.25, icono: '🌮' }
