        function copiarMenuTexto() {
            const numTiempos = document.querySelector('input[name="tiemposComida"]:checked').value;
            let texto = `=== PLAN NUTRICIONAL Y MENÚ MEXICANO ===\n`;
            texto += `Energía Objetivo: ${currentCalculatedData.kcal} kcal/día\n`;
            texto += `Macros: Prot: ${currentCalculatedData.protG}g | Carbos: ${currentCalculatedData.choG}g | Grasas: ${currentCalculatedData.fatG}g\n`;
            texto += `Esquema: ${numTiempos} Tiempos de Comida\n\n`;

            const cards = document.querySelectorAll('#menuContainer > div');
            cards.forEach(c => {
                const titulo = c.querySelector('h4').innerText;
                const macros = c.querySelector('div.text-xs.font-medium').innerText;
                const platillo = c.querySelector('h5').innerText;
                const ingr = Array.from(c.querySelectorAll('ul li')).map(li => `- ${li.innerText}`).join('\n');
                texto += `--- ${titulo} (${macros}) ---\n${platillo}\n${ingr}\n\n`;
            });

            const textarea = document.createElement('textarea');
            textarea.value = texto;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                alert('¡Menú copiado exitosamente al portapapeles!');
            } catch (err) {
                alert('No se pudo copiar automáticamente. Por favor seleccione y copie manualmente.');
            }
            document.body.removeChild(textarea);
        }
